# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# Google Gemini API key (required for AI features: meal photo analysis, AI assistant)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# JWT secrets (generate with: openssl rand -hex 64)
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# CORS allowlist (comma-separated origins for the web + mobile clients)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8081
